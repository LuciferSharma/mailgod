# ─── Required ────────────────────────────────────────────────────────────────
# MongoDB (local, docker-compose service, or Atlas mongodb+srv://...)
MONGODB_URI=mongodb://localhost:27017/mailgod

# Login + signing secrets. The server REFUSES to start with NODE_ENV=production
# until these are set. Generate with: openssl rand -hex 32
ADMIN_PASSWORD=change-me-to-something-strong
JWT_SECRET=
UNSUBSCRIBE_SECRET=

# ─── Sending (SendGrid) ──────────────────────────────────────────────────────
# Leave empty to run without sending (sends are recorded but not delivered).
SENDGRID_API_KEY=
FROM_EMAIL=hello@yourdomain.com
FROM_NAME=Your Company

# Reply handling: replies go to reply+<token>@REPLY_DOMAIN via SendGrid Inbound Parse.
# See docs/sendgrid-inbound-setup.md
REPLY_DOMAIN=reply.yourdomain.com

# ─── URLs ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Public URL of this server (used in unsubscribe links)
PLATFORM_URL=http://localhost:3001

# ─── Limits ──────────────────────────────────────────────────────────────────
GLOBAL_RATE_LIMIT=5000
FREQUENCY_CAP_DAILY=1
BATCH_SIZE=500
INBOX_ONE_OFF_LIMIT=50

# ─── Sender pool (optional) ─────────────────────────────────────────────────
# Send through your own SMTP mailboxes and poll their IMAP inboxes for replies.
MAILBOX_POOL_ENABLED=false
# Encrypts stored mailbox passwords (falls back to JWT_SECRET). Don't lose it.
MAILBOX_SECRET=

# ─── Cal.com bookings webhook (optional) ────────────────────────────────────
CALCOM_SECRET=

# ─── Temporal (optional — flows run in-process when disabled) ───────────────
USE_TEMPORAL=false
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=default

# ─── Redis (optional — in-memory rate limiter when empty) ───────────────────
REDIS_URL=
